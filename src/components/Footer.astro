---
const year = new Date().getFullYear();
---

<footer class="bg-dark text-gray-300">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-accent font-heading font-bold text-lg">N</span>
          <span class="font-heading font-semibold text-white text-lg">Nicholas.K</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed max-w-xs">
          Growth & Partnerships Advisor. 17 years scaling Spotify's global distribution — now helping businesses build the partnerships and growth engines that compound over time.
        </p>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Quick Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-accent transition-colors">About</a></li>
          <li><a href="/services" class="hover:text-accent transition-colors">Services</a></li>
          <li><a href="/contact" class="hover:text-accent transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Get in Touch</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="mailto:hello@nicholask.dev" class="hover:text-accent transition-colors">hello@nicholask.dev</a>
          </li>
          <li>
            <a href="https://linkedin.com/in/nicholask" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
          </li>
        </ul>
        <a href="/contact" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-secondary px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-secondary/90">
          Book a Call
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-gray-700 pt-8 text-center text-xs text-gray-500">
      &copy; {year} Nicholas.K — Growth & Partnerships Advisor. All rights reserved.
    </div>
  </div>
</footer>
