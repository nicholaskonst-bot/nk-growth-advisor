---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Services — Nicholas.K | Growth & Partnerships Advisor">
  <Header />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary via-dark to-primary pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent mb-4">Services</p>
      <h1 class="font-heading text-4xl font-bold text-white md:text-5xl max-w-3xl">
        Advisory Services That Move the Needle
      </h1>
      <p class="mt-6 text-lg text-gray-300 max-w-2xl leading-relaxed">
        Tailored advisory designed for businesses ready to scale through strategic partnerships and systematic growth approaches.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-6">
      <div class="space-y-16">

        <!-- Service 1 -->
        <div class="grid gap-8 md:grid-cols-2 items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full bg-secondary/10 px-4 py-1.5 text-xs font-semibold text-secondary mb-4">
              Core Advisory
            </div>
            <h2 class="font-heading text-2xl font-bold text-primary md:text-3xl">Partnership Strategy & Development</h2>
            <p class="mt-4 text-muted leading-relaxed">
              From identifying the right partners to negotiating and structuring deals, I guide you through every stage of building a high-impact partnership portfolio.
            </p>
            <ul class="mt-6 space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-secondary">&#10003;</span>
                <span class="text-sm text-gray-700">Ecosystem mapping and partner identification</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-secondary">&#10003;</span>
                <span class="text-sm text-gray-700">Partner scoring and prioritisation frameworks</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-secondary">&#10003;</span>
                <span class="text-sm text-gray-700">Deal structuring and negotiation support</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-secondary">&#10003;</span>
                <span class="text-sm text-gray-700">Partner onboarding and enablement programs</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-secondary">&#10003;</span>
                <span class="text-sm text-gray-700">Ongoing relationship management strategy</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl bg-gradient-to-br from-secondary/5 to-secondary/15 p-10 flex items-center justify-center min-h-[280px]">
            <div class="text-center">
              <svg class="mx-auto h-16 w-16 text-secondary mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <p class="font-heading font-semibold text-primary">Build Your Partnership Ecosystem</p>
            </div>
          </div>
        </div>

        <hr class="border-gray-200" />

        <!-- Service 2 -->
        <div class="grid gap-8 md:grid-cols-2 items-center">
          <div class="md:order-2">
            <div class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-1.5 text-xs font-semibold text-accent mb-4">
              Growth Engine
            </div>
            <h2 class="font-heading text-2xl font-bold text-primary md:text-3xl">Growth Strategy & Execution</h2>
            <p class="mt-4 text-muted leading-relaxed">
              I help you design and implement growth systems that are repeatable, measurable, and scalable — from go-to-market strategy to funnel optimisation.
            </p>
            <ul class="mt-6 space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">&#10003;</span>
                <span class="text-sm text-gray-700">Go-to-market strategy and launch planning</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">&#10003;</span>
                <span class="text-sm text-gray-700">Customer acquisition channel analysis</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">&#10003;</span>
                <span class="text-sm text-gray-700">Revenue model design and pricing strategy</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">&#10003;</span>
                <span class="text-sm text-gray-700">Growth KPI frameworks and dashboards</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-accent">&#10003;</span>
                <span class="text-sm text-gray-700">Competitive positioning and differentiation</span>
              </li>
            </ul>
          </div>
          <div class="md:order-1 rounded-2xl bg-gradient-to-br from-accent/5 to-accent/15 p-10 flex items-center justify-center min-h-[280px]">
            <div class="text-center">
              <svg class="mx-auto h-16 w-16 text-accent mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              <p class="font-heading font-semibold text-primary">Systematic Growth</p>
            </div>
          </div>
        </div>

        <hr class="border-gray-200" />

        <!-- Service 3 -->
        <div class="grid gap-8 md:grid-cols-2 items-center">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-xs font-semibold text-primary mb-4">
              Hands-On
            </div>
            <h2 class="font-heading text-2xl font-bold text-primary md:text-3xl">Workshops & Team Enablement</h2>
            <p class="mt-4 text-muted leading-relaxed">
              Interactive sessions designed to align your team, build partnership capabilities, and create actionable roadmaps you can execute immediately.
            </p>
            <ul class="mt-6 space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-primary">&#10003;</span>
                <span class="text-sm text-gray-700">Partnership readiness assessment workshops</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-primary">&#10003;</span>
                <span class="text-sm text-gray-700">Growth strategy alignment sessions</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-primary">&#10003;</span>
                <span class="text-sm text-gray-700">Sales & BD team enablement programs</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-primary">&#10003;</span>
                <span class="text-sm text-gray-700">Executive briefings on partnership trends</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-primary">&#10003;</span>
                <span class="text-sm text-gray-700">Custom training modules for your team</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl bg-gradient-to-br from-primary/5 to-primary/15 p-10 flex items-center justify-center min-h-[280px]">
            <div class="text-center">
              <svg class="mx-auto h-16 w-16 text-primary mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              <p class="font-heading font-semibold text-primary">Empower Your Team</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-sm font-semibold uppercase tracking-widest text-secondary mb-3">Process</p>
        <h2 class="font-heading text-3xl font-bold text-primary md:text-4xl">How We Work Together</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white font-heading font-bold">1</div>
          <h3 class="font-heading font-semibold text-primary mb-2">Discovery Call</h3>
          <p class="text-sm text-muted">We discuss your goals, challenges, and current landscape to see if there's a fit.</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white font-heading font-bold">2</div>
          <h3 class="font-heading font-semibold text-primary mb-2">Deep Dive</h3>
          <p class="text-sm text-muted">I analyse your market, competitive position, and partnership opportunities in depth.</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white font-heading font-bold">3</div>
          <h3 class="font-heading font-semibold text-primary mb-2">Strategy & Roadmap</h3>
          <p class="text-sm text-muted">Together, we create a clear, actionable plan with priorities and timelines.</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary text-white font-heading font-bold">4</div>
          <h3 class="font-heading font-semibold text-primary mb-2">Execute & Scale</h3>
          <p class="text-sm text-muted">I support implementation, track KPIs, and iterate to maximise results.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-secondary to-primary py-16">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="font-heading text-3xl font-bold text-white">Not Sure Which Service You Need?</h2>
      <p class="mt-4 text-white/80 max-w-xl mx-auto">
        Book a free 30-minute discovery call and we'll figure out the best path forward for your business together.
      </p>
      <a href="/contact" class="mt-8 inline-flex items-center justify-center rounded-lg bg-accent px-8 py-3.5 text-sm font-bold text-primary transition-all hover:bg-accent/90 hover:shadow-xl">
        Book Your Free Call
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
